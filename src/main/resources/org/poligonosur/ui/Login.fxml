<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Inicio de sesión -->
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.poligonosur.ui.LoginPantalla">
   <top>
      <!-- Cabecera -->
      <HBox alignment="CENTER_LEFT" prefHeight="60.0">
         <padding><Insets left="40.0" right="40.0" /></padding>
         <Label text="Gestor de suscripciones" />
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER">
         <!-- Formulario de acceso -->
         <VBox maxWidth="420.0" spacing="24.0">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <Label text="Inicio de sesión" />
            <VBox spacing="8.0">
               <Label text="Email" />
               <TextField fx:id="txtEmail" />
            </VBox>
            <VBox spacing="8.0">
               <Label text="Contraseña" />
               <PasswordField fx:id="txtPassword" />
            </VBox>
            <Label fx:id="lblError" />
            <Button defaultButton="true" maxWidth="Infinity" onAction="#entrar" text="Entrar" />
            <Hyperlink onAction="#registrarse" text="¿No tienes cuenta? Regístrate" />
         </VBox>
      </VBox>
   </center>
</BorderPane>
