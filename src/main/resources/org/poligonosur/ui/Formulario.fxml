<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Crear o modificar suscripción -->
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.poligonosur.ui.FormularioPantalla">
   <top>
      <!-- Cabecera -->
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="cabecera">
         <padding><Insets left="40.0" right="40.0" /></padding>
         <Label text="Gestor de suscripciones" />
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding><Insets bottom="16.0" left="40.0" right="40.0" top="16.0" /></padding>
         <Label fx:id="lblTitulo" styleClass="titulo" />

         <!-- Formulario -->
         <VBox maxWidth="720.0" spacing="20.0">
            <!-- Servicio -->
            <HBox alignment="BOTTOM_LEFT" spacing="16.0">
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <Label text="Servicio" />
                  <ComboBox fx:id="cmbServicio" maxWidth="Infinity" />
               </VBox>
               <Button onAction="#nuevoServicio" text="Nuevo servicio" />
            </HBox>

            <!-- Importe y periodicidad -->
            <HBox spacing="24.0">
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <Label text="Importe" />
                  <TextField fx:id="txtImporte" />
               </VBox>
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <Label text="Periodicidad" />
                  <ComboBox fx:id="cmbPeriodicidad" maxWidth="Infinity" />
               </VBox>
            </HBox>

            <!-- Inicio y aviso -->
            <HBox spacing="24.0">
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <Label text="Fecha de inicio" />
                  <DatePicker fx:id="dateInicio" maxWidth="Infinity" />
               </VBox>
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <Label text="Días de aviso" />
                  <TextField fx:id="txtDiasAviso" />
               </VBox>
            </HBox>

            <!-- Notas -->
            <VBox spacing="8.0">
               <Label text="Notas" />
               <TextArea fx:id="txtNotas" prefHeight="72.0" wrapText="true" />
            </VBox>

            <!-- Acciones -->
            <HBox spacing="12.0">
               <Button defaultButton="true" onAction="#guardar" styleClass="boton-principal" text="Guardar" />
               <Button cancelButton="true" onAction="#cancelar" text="Cancelar" />
            </HBox>
         </VBox>
      </VBox>
   </center>
</BorderPane>
